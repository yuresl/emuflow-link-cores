diff --git a/libgambatte/libretro/net_serial.cpp b/libgambatte/libretro/net_serial.cpp
index b19605b..3de4bc0 100644
--- a/libgambatte/libretro/net_serial.cpp
+++ b/libgambatte/libretro/net_serial.cpp
@@ -16,6 +16,41 @@
 #include <netdb.h>
 #endif
 
+#include <emscripten.h>
+bool JsSerial::connected()
+{
+	return EM_ASM_INT({ return Module['emuflowSerial'] ? 1 : 0; }) != 0;
+}
+unsigned char JsSerial::send(unsigned char data, bool fastCgb)
+{
+	return EM_ASM_INT({ var s = Module['emuflowSerial']; return s ? s['send']($0, $1) : 0; }, data, fastCgb ? 1 : 0);
+}
+/* Sem o site do outro lado (o cabo caiu no meio do byte), a transferencia termina como cabo solto. */
+bool JsSerial::poll(unsigned char& in, bool& fastCgb)
+{
+	int v = EM_ASM_INT({ var s = Module['emuflowSerial']; return s ? s['poll']() : 255; });
+	if (v < 0) return false;
+	in = v & 0xFF;
+	fastCgb = (v >> 8) & 1;
+	return true;
+}
+void JsSerial::noteExternal(unsigned char sb)
+{
+	EM_ASM({ var s = Module['emuflowSerial']; if (s) s['noteExternal']($0); }, sb);
+}
+void JsSerial::cancel()
+{
+	EM_ASM({ var s = Module['emuflowSerial']; if (s) s['cancel'](); });
+}
+bool JsSerial::check(unsigned char out, unsigned char& in, bool& fastCgb)
+{
+	int v = EM_ASM_INT({ var s = Module['emuflowSerial']; return s ? s['clock']($0) : -1; }, out);
+	if (v < 0) return false;
+	in = v & 0xFF;
+	fastCgb = (v >> 8) & 1;
+	return true;
+}
