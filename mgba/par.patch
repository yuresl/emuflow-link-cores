 #define GBA_WIFI_LINK_NO_CLIENT UINT16_MAX
 
+/*
+ * EmuFlow: o transporte fica no site, que poe `Module.emuflowLink` enquanto os
+ * dois estao ligados e o tira ao desligar. O RetroArch nao entra na conversa.
+ */
+#include <emscripten.h>
+static uint16_t _jsPeer = 0;
+static bool _jsStarted = false;
+static void RETRO_CALLCONV _jsSend(int flags, const void* buf, size_t len, uint16_t client) {
+	UNUSED(flags); UNUSED(client);
+	EM_ASM({ var l = Module['emuflowLink']; if (l) l['send'](HEAPU8.slice($0, $0 + $1)); }, buf, len);
+}
+static void RETRO_CALLCONV _receive(const void* buf, size_t len, uint16_t clientId);
+static void RETRO_CALLCONV _jsPoll(void) {
+	for (;;) {
+		int n = EM_ASM_INT({ var l = Module['emuflowLink']; return l ? l['peek']() : 0; });
+		if (n <= 0) break;
+		uint8_t* b = malloc(n);
+		if (!b) break;
+		EM_ASM({ HEAPU8.set(Module['emuflowLink']['take'](), $0); }, b);
+		_receive(b, n, _jsPeer);
+		free(b);
+	}
+}
+#ifdef EMUFLOW_LINK_TEST
+#define _jsExposeMemory(iwram, wram) \
+	EM_ASM({ globalThis.__gbaW = $0; globalThis.__gbaI = $1; globalThis.__gbaHeap = function() { return HEAPU8; }; }, wram, iwram)
+#endif
