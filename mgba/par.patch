+/* EmuFlow: liga e desliga a sessao conforme o site. Da para religar sem reabrir o jogo. */
+static void _jsSync(void) {
+	int id = EM_ASM_INT({ var l = Module['emuflowLink']; return l ? l['id'] : -1; });
+	if (id < 0) {
+		if (_jsStarted) {
+			_jsStarted = false;
+			_stop();
+			_deinitSession(&_adapter);
+		}
+		return;
+	}
+	if (_jsStarted || !_adapter.registered) return;
+	_jsStarted = true;
+	_jsPeer = id == 0 ? 1 : 0;
+	_start((uint16_t) id, _jsSend, _jsPoll);
+	if (id == 0) _connected(1);
+}
