diff --git a/mednafen/wswan/comm.c b/mednafen/wswan/comm.c
index 5ffa27b..a068f90 100644
--- a/mednafen/wswan/comm.c
+++ b/mednafen/wswan/comm.c
@@ -25,6 +25,7 @@
  * interrupt; nothing is ever received. */
 
 #include <string.h>
+#include <emscripten.h>
 
 #include "wswan.h"
 #include "interrupt.h"
@@ -35,6 +36,8 @@
 static uint8 Control;
 static uint8 SendBuf, RecvBuf;
 static bool SendLatched, RecvLatched;
+/* EmuFlow: um byte leva 12,5 linhas a 9600 bps e 3 a 38400. */
+static int SendLines;
 
 void Comm_Reset(void)
 {
@@ -52,12 +55,36 @@ void Comm_Reset(void)
 /* Called once per scanline from wsExecuteLine(). */
 void Comm_Process(void)
 {
+   {
+      static int lines;
+      lines++;
+      EM_ASM({ var w = Module['emuflowSerial']; if (w) w['sync']($0); }, lines);
+   }
+
    if(SendLatched && (Control & 0x80))
    {
-      /* No link peer; the byte leaves the shift register
-       * immediately. */
-      SendLatched = false;
-      WSwan_Interrupt(WSINT_SERIAL_SEND);
+      if(SendLines > 0)
+         SendLines--;
+      else
+      {
+         /* EmuFlow: o cabo passa pelo site (Module.emuflowSerial). */
+         EM_ASM({ var w = Module['emuflowSerial']; if (w) w['tx']($0); }, SendBuf);
+         SendLines = (Control & 0x40) ? 3 : 12;
+         SendLatched = false;
+         WSwan_Interrupt(WSINT_SERIAL_SEND);
+      }
+   }
+
+   /* EmuFlow: o bit 7 liga a porta (wstech24.txt); os jogos escrevem 0x80 e 0xC0, sem o 0x20. */
+   if((Control & 0x80) && !RecvLatched)
+   {
+      int value = EM_ASM_INT({ var w = Module['emuflowSerial']; return w ? w['rx']() : -1; });
+      if(value >= 0)
+      {
+         RecvBuf = (uint8)value;
+         RecvLatched = true;
+         WSwan_InterruptAssert(WSINT_SERIAL_RECV, RecvLatched);
+      }
    }
 }
 
@@ -77,7 +104,7 @@ uint8 Comm_Read(uint8 A)
       if((Control & 0x80) && !SendLatched)
          ret |= 0x4;
 
-      if((Control & 0x20) && RecvLatched)
+      if(RecvLatched)
          ret |= 0x1;
 
       return(ret);
