diff --git a/mednafen/ngp/system.c b/mednafen/ngp/system.c
index 6ebfb2f..0abf39e 100644
--- a/mednafen/ngp/system.c
+++ b/mednafen/ngp/system.c
@@ -10,9 +10,34 @@
 
 #include <streams/file_stream.h>
 
-bool system_comms_read(uint8_t* buffer) { return 0; }
-bool system_comms_poll(uint8_t* buffer) { return 0; }
-void system_comms_write(uint8_t data) { }
+/* EmuFlow: o cabo passa pelo site (Module.emuflowSerial). */
+#include <emscripten.h>
+bool system_comms_read(uint8_t* buffer)
+{
+   int value = buffer ? EM_ASM_INT({ var w = Module['emuflowSerial']; return w ? w['rx']() : -1; }) : EM_ASM_INT({ var w = Module['emuflowSerial']; return w ? w['peek']() : -1; });
+   if (value < 0)
+      return 0;
+   if (buffer)
+      *buffer = (uint8_t)value;
+   return 1;
+}
+bool system_comms_poll(uint8_t* buffer)
+{
+   int value = EM_ASM_INT({ var w = Module['emuflowSerial']; return w ? w['peek']() : -1; });
+   if (value < 0)
+      return 0;
+   if (buffer)
+      *buffer = (uint8_t)value;
+   return 1;
+}
+void system_comms_write(uint8_t data) { EM_ASM({ var w = Module['emuflowSerial']; if (w) w['tx']($0); }, data); }
+
+void system_comms_line(void)
+{
+   static int lines;
+   lines++;
+   EM_ASM({ var w = Module['emuflowSerial']; if (w) w['sync']($0); }, lines);
+}
 
